# ==============================================================================
# Mizpa Management System - Environment Variables Configuration
# ==============================================================================

# Data Source Provider: 'in-memory' | 'supabase'
DATA_SOURCE=in-memory

# Supabase Credentials (Required when DATA_SOURCE=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-actions
